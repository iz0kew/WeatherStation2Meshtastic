{
  "build": {
    "arduino": {
      "ldscript": "nrf52840_s140_v6.ld"
    },
    "core": "nRF5",
    "cpu": "cortex-m4",
    "extra_flags": "-DNRF52840_XXAA -DNRF52_PROMICRO_DIY_HTRA62",
    "f_cpu": "64000000L",
    "hwids": [
      ["0x239A", "0x8029"],
      ["0x239A", "0x0029"]
    ],
    "mcu": "nrf52840",
    "variant": "nrf52_promicro_diy_htra62",
    "softdevice": {
      "sd_flags": "-DS140",
      "sd_name": "s140",
      "sd_version": "6.1.1",
      "sd_fwid": "0x00B6"
    },
    "bsp": {
      "name": "adafruit"
    },
    "usb_product": "nRF52 ProMicro DIY (HT-RA62)"
  },
  "connectivity": [
    "bluetooth"
  ],
  "debug": {
    "jlink_device": "nRF52840_xxAA",
    "openocd_target": "nrf52.cfg",
    "svd_path": "nrf52840.svd"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "nRF52840 Pro-Micro/NiceNano DIY + HT-RA62 (board locale del progetto, condivisa da MASN e FakeTec)",
  "upload": {
    "maximum_ram_size": 248832,
    "maximum_size": 815104,
    "protocol": "nrfutil",
    "speed": 115200,
    "protocols": [
      "jlink",
      "nrfjprog",
      "nrfutil",
      "cmsis-dap",
      "sam-ba",
      "blackmagic"
    ],
    "use_1200bps_touch": true,
    "require_upload_port": true,
    "wait_for_upload_port": true
  },
  "url": "https://github.com/meshtastic/firmware/tree/master/variants/nrf52840/diy",
  "vendor": "community (non ufficiale)"
}
